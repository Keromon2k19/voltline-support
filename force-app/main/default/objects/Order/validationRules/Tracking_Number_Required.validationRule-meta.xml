<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tracking_Number_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Shipping_Status__c, &quot;Shipped&quot;),
        ISPICKVAL(Shipping_Status__c, &quot;Delivered&quot;)
    ),
    LEN(TRIM(Tracking_Number__c)) = 0
)</errorConditionFormula>
    <errorDisplayField>Tracking_Number__c</errorDisplayField>
    <errorMessage>You must enter the tracking number for orders with &quot;Shipped&quot; or &quot;Delivered&quot; state</errorMessage>
</ValidationRule>
